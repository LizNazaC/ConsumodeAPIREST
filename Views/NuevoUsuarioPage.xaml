<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ConsumodeAPIREST.ViewModels"
             x:Class="ConsumodeAPIREST.Views.NuevoUsuarioPage"
             x:DataType="viewmodels:NuevoUsuarioViewModel"
             Title="Nuevo usuario">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">
            <Entry Placeholder="Nombre" Text="{Binding Name}" />
            <Entry Keyboard="Email" Placeholder="Email" Text="{Binding Email}" />
            <Entry Placeholder="Teléfono" Text="{Binding Phone}" />
            <Entry Placeholder="Website" Text="{Binding Website}" />
            <Button Command="{Binding EnviarCommand}" Text="Enviar" />
            <ActivityIndicator HorizontalOptions="Center"
                               IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}" />
            <Label FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Text="{Binding CreatedMessage}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
